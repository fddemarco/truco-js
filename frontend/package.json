{
  "name": "truco-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && prettier --check .",
    "format": "prettier --write .",
    "gen-cards": "node scripts/generate-cards.mjs",
    "gen-avatars": "node scripts/generate-avatars.mjs",
    "gen-api": "openapi-typescript openapi.json --default-non-nullable false -o src/lib/api/schema.d.ts && prettier --write src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "marked": "^18.1.3",
    "openapi-fetch": "^0.14.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.48.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.16",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "^22.18.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.43.0",
    "svelte-check": "^4.3.3",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
